<?xml version="1.0"?>
<extension key="com.skvare.eventinstallment" type="module">
  <file>eventinstallment</file>
  <name>Event Installment</name>
  <description>Parent/child event signup for related contacts, with child-number, sibling and dated (early bird) discounts, group discounts and installment payments.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Sunil Pawar</author>
    <email>sunil@skvare.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/Skvare/com.skvare.eventinstallment</url>
    <url desc="Documentation">https://github.com/Skvare/com.skvare.eventinstallment</url>
    <url desc="Support">https://github.com/Skvare/com.skvare.eventinstallment</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-22</releaseDate>
  <version>1.1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Eventinstallment</namespace>
    <format>26.10.3</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\Eventinstallment\AutomaticUpgrader</upgrader>
</extension>
